{
  "name": "pc-laptop-doctor-ai",
  "version": "7.5.0-beta.6",
  "private": true,
  "description": "Local Windows game optimizer with live CPU/GPU monitoring, trusted game Autopilot, and reviewed large-file storage recovery",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "test": "node --test",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "pack:win": "npm run build && electron-builder --win dir --x64 --publish never"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.14"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^45.3.1",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dvilr.pclaptopdoctor",
    "productName": "PC Laptop Doctor AI",
    "copyright": "Copyright 2026 DVILR",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "PC-Laptop-Doctor-AI-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "PC-Laptop-Doctor-AI-Portable-${version}-${arch}.${ext}"
    }
  }
}
